# Ethereum mainnet. Values only, no secrets. KEYSTORE_ACCOUNT names a Foundry keystore and is
# supplied by the operator at deploy time; the keystore password and ETHERSCAN_API_KEY come from
# the shell only.
CHAIN_ID=1
RPC_URL_DEFAULT=https://ethereum-rpc.publicnode.com
# Ladder remapping the build must carry (checked against forge config).
LADDER=mainnet
VERIFY=1
REQUIRE_MAIN_BRANCH=1
WALLET_MODE=keystore
KEYSTORE_ACCOUNT=
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
ADMIN=0xCB43078C32423F5348Cab5885911C3B5faE217F9
# Dependencies, from deployments/dependencies.json chain 1.
SHAPES=0x6fE9193276bF7aBCbEE44AB7aFd717d637D6FAf0
FWA_FACTORY=0xF5A3A153164791AB579C3d9ba5DBECf7cDfd300c
FWA_IMPLEMENTATION=0xeaa4d032908a9734a2c7939c0d211c35ad51eb31
FWA_VRF_SERVICE=0xa4adfc35db18326efb3b5d9bf66a8103ec2d5ee2
# Draw Packs (2-unit minimum) is not deployed on mainnet yet. Set after it is.
DRAW_PACKS=
CREATE_POOL=0

# Mix table: rows separated by ';', each row is rung,rung,...:shareBps. Rungs index the Shapes ladder;
# rows of two or more rungs are Draw Packs. Shares sum to 10000.
MIX_ROWS="0:4000;0,0:3000;0,0,0:2000;1:1000"

# Fee split in bps. premium + maintenance + feed is at most 1000.
PREMIUM_BPS=200
MAINTENANCE_BPS=100
FEED_BPS=400
# Share of the GRAIL feed and of the entry contribution that goes to the minor track, in bps.
MINOR_SHARE_BPS=2000

# Entry curve in bps (cap at most 2500) and its reference NAV in wei.
ENTRY_BASE_BPS=1100
ENTRY_SLOPE_BPS=2000
ENTRY_CAP_BPS=2500
ENTRY_REFERENCE_WEI=55000000000000000000

# GRAIL tracks, wei. The step is a multiple of the ladder unit. LIST_BPS is the list price as a
# share of track backing. The list price decays by DECAY_WEI_PER_PULL per pull down to the floor.
# Pool requires FLOOR_WEI nonzero and at most TARGET_WEI * LIST_BPS / 10000 (minor 0.75, major 18.75
# ether at mainnet scale).
GRAIL_MINOR_TARGET_WEI=1000000000000000000
GRAIL_MINOR_STEP_WEI=100000000000000000
GRAIL_MINOR_LIST_BPS=7500
GRAIL_MINOR_DECAY_WEI_PER_PULL=1000000000000000
GRAIL_MINOR_FLOOR_WEI=250000000000000000
GRAIL_MAJOR_TARGET_WEI=25000000000000000000
GRAIL_MAJOR_STEP_WEI=500000000000000000
GRAIL_MAJOR_LIST_BPS=7500
GRAIL_MAJOR_DECAY_WEI_PER_PULL=1000000000000000
GRAIL_MAJOR_FLOOR_WEI=1000000000000000000

# 0 means no cap on NAV.
NAV_CAP_WEI=0
ROTATE_INTERVAL_SECONDS=3600
# Seconds from FWA pool creation to the earliest open().
OPENING_DEADLINE_SECONDS=86400
MIN_ITEMS=30
GRAIL_PROB_CAP_BPS=1000
# Smallest GRAIL list price decrease, in bps of the current price, that rotate applies as a reprice.
REPRICE_MIN_BPS=100
