# Ethereum mainnet. Values only, no secrets. KEYSTORE_ACCOUNT names a Foundry keystore the operator supplies at
# deploy time; the keystore password and ETHERSCAN_API_KEY come from the shell only.
CHAIN_ID=1
RPC_URL_DEFAULT=https://gateway.tenderly.co/public/mainnet
LADDER=mainnet
VERIFY=1
REQUIRE_MAIN_BRANCH=1
WALLET_MODE=keystore
KEYSTORE_ACCOUNT=
# The deploy wallet pays gas and the FWA creation-fee purchase; it keeps no power afterwards.
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
# The owner's governance address: proposer and executor of the timelock. Must differ from DEPLOYER.
GOVERNANCE=
# Dependencies, from deployments/dependencies.json chain 1.
SHAPES=0x6fE9193276bF7aBCbEE44AB7aFd717d637D6FAf0
SHAPE_PACKS=0xf21514B090Da7dF4390803497d6ae673801E5cA7
FWA_FACTORY=0xF5A3A153164791AB579C3d9ba5DBECf7cDfd300c
FWA_IMPLEMENTATION=0xeaa4d032908a9734a2c7939c0d211c35ad51eb31
FWA_VRF_SERVICE=0xa4adfc35db18326efb3b5d9bf66a8103ec2d5ee2
POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90
# ETH margin over FWA's spot price when buying the 50,000 FWA creation fee (covers FWA's 1% buy fee and impact).
FWA_FEE_MARGIN_BPS=500
CREATE_FWA_POOL=true
# Single-sided launch price: ENGINE per ETH = 1.0001^START_TICK, a multiple of 200 (≈ 100M ENGINE per ETH, FDV ≈ 10 ETH; docs/ECONOMICS.md section 8). No ETH is paired:
# the 80% float is the whole position and the price can never go above this start. It also fixes the genesis rate cap.
START_TICK=184200
# Opening capital sent to PrizeVault after deployment (about 28 ETH recommended, docs/ECONOMICS.md section 5).
OPENING_CAPITAL_ETH=
# KeeperFund seed (0.05 ETH); later keeper pay is topped up from trading fees within a 1 ETH lifetime limit.
KEEPER_SEED=50000000000000000
