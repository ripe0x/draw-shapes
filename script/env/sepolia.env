# Sepolia. Values only, no secrets. The Sepolia Shapes ladder unit is 0.0001 ETH; the launch config scales every
# backing by the live unit(). The build must select the testnet ladder (FOUNDRY_PROFILE=sepolia).
CHAIN_ID=11155111
RPC_URL_DEFAULT=https://ethereum-sepolia-rpc.publicnode.com
LADDER=testnet
FOUNDRY_PROFILE=sepolia
VERIFY=1
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=keystore
KEYSTORE_ACCOUNT=
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
GOVERNANCE=
SHAPES=0x6C2F9c00F44FBBF141dD166979903004b80D5f99
SHAPE_PACKS=
FWA_FACTORY=0xdF0b2Cf3dCc47B79b42e310c06C98df93f894358
FWA_IMPLEMENTATION=0x00f488ba41D571717aEC8DA2FEE5dE2578995AD7
FWA_VRF_SERVICE=0xd2529DB53972C79acD7aa86A97Ad6E456c851620
# Uniswap v4 PoolManager on Sepolia.
POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
FWA_FEE_MARGIN_BPS=500
# The Sepolia FWA stack differs from mainnet (docs/IMPLEMENTOR_DECISIONS.md); see docs/DEPLOY.md.
CREATE_FWA_POOL=false
