# Sepolia. Values only, no secrets. The Sepolia ladder unit is 0.0001 ETH, so every wei value is
# the mainnet value divided by 100. The build must select the testnet ladder (LADDER=testnet);
# foundry.toml needs a profile that remaps ladder/ to lib/shapes/ladders/testnet/ and the
# wrapper refuses until forge config shows it.
CHAIN_ID=11155111
RPC_URL_DEFAULT=https://ethereum-sepolia-rpc.publicnode.com
LADDER=testnet
FOUNDRY_PROFILE=sepolia
VERIFY=1
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=keystore
KEYSTORE_ACCOUNT=
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
ADMIN=0xCB43078C32423F5348Cab5885911C3B5faE217F9
# Dependencies, from deployments/dependencies.json chain 11155111.
SHAPES=0x6C2F9c00F44FBBF141dD166979903004b80D5f99
FWA_FACTORY=0xdF0b2Cf3dCc47B79b42e310c06C98df93f894358
# The carried values did not match the factory. These are the factory's implementation() and
# vrfService() read on 2026-10-13.
FWA_IMPLEMENTATION=0x00f488ba41D571717aEC8DA2FEE5dE2578995AD7
FWA_VRF_SERVICE=0xd2529DB53972C79acD7aa86A97Ad6E456c851620
# The Sepolia Draw Packs in lib/draw-packs/deployments is the three-unit collection, which fails
# the two-unit check. Deploy a two-unit collection and set it here.
DRAW_PACKS=
CREATE_POOL=0

# Mix table: rows separated by ';', each row is rung,rung,...:shareBps. Rungs index the Shapes ladder;
# rows of two or more rungs are Draw Packs. Shares sum to 10000.
MIX_ROWS="0:3800;0,0:2800;0,0,0:1900;1:1000;2:400;3:100"

# Fee split in bps. premium + maintenance + feed is at most 1000.
PREMIUM_BPS=200
MAINTENANCE_BPS=100
FEED_BPS=400
# Share of the GRAIL feed and of the entry contribution that goes to the minor track, in bps.
MINOR_SHARE_BPS=2000

# Entry curve in bps (cap at most 2500) and its reference NAV in wei.
ENTRY_BASE_BPS=1100
ENTRY_SLOPE_BPS=2000
ENTRY_CAP_BPS=2500
ENTRY_REFERENCE_WEI=550000000000000000

# GRAIL tracks, wei. The step is a multiple of the ladder unit. LIST_BPS is the list price as a
# share of track backing. The list price decays by DECAY_WEI_PER_PULL per pull down to the floor.
# Pool requires FLOOR_WEI nonzero and at most TARGET_WEI * LIST_BPS / 10000 (minor 0.75, major 18.75
# ether at mainnet scale).
GRAIL_MINOR_TARGET_WEI=10000000000000000
GRAIL_MINOR_STEP_WEI=1000000000000000
GRAIL_MINOR_LIST_BPS=7500
GRAIL_MINOR_DECAY_WEI_PER_PULL=10000000000000
GRAIL_MINOR_FLOOR_WEI=2500000000000000
GRAIL_MAJOR_TARGET_WEI=250000000000000000
GRAIL_MAJOR_STEP_WEI=5000000000000000
GRAIL_MAJOR_LIST_BPS=7500
GRAIL_MAJOR_DECAY_WEI_PER_PULL=10000000000000
GRAIL_MAJOR_FLOOR_WEI=10000000000000000

# Deposits stop at this NAV. 0 means no cap.
NAV_CAP_WEI=1000000000000000000
# Minimum seconds between inventory changes. At least the FWA factory's inventoryChangeCooldown.
ROTATE_INTERVAL_SECONDS=900
# Seconds from FWA pool creation to the earliest open().
OPENING_DEADLINE_SECONDS=3600
MIN_ITEMS=100
GRAIL_PROB_CAP_BPS=1000
# Replacement listing. settle lists when this many replacements are queued, or the queue has been
# nonempty for BATCH_MAX_AGE_SECONDS.
BATCH_MIN=5
BATCH_MAX_AGE_SECONDS=3600
# Replacement row choice: probability in bps of the surprise step, multiplier of a row's relative
# deficit in its draw weight, and headroom in bps above a row's target.
SURPRISE_BPS=200
RESTORE_K=8
BAND_BPS=3000
# Share of ordinary NAV in bps that cash keeps after a mint or a kept Shape.
RESERVE_BPS=1000
