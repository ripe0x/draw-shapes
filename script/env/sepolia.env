# Ethereum Sepolia. Values only, no secrets. Shapes is pinned from the repository deployment record
# and independently checked on-chain. FWA values are the published Sepolia custom-pool stack,
# the current-generation stack FWA published on 2026-09-30, checked at block 11817529 (docs/external/sepolia.md). The build profile selects the testnet
# ladder, whose unit is 0.0001 ETH.
CHAIN_ID=11155111
FOUNDRY_PROFILE=sepolia
RPC_URL_DEFAULT=https://ethereum-sepolia-rpc.publicnode.com
# Verification runs after deployment with forge verify-contract once an explorer key is in the shell.
VERIFY=0
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=keystore
# Sepolia-only keystore created 2026-09-15; funded with 1 Sepolia ETH by the owner. The password
# file path is passed from the shell as KEYSTORE_PASSWORD_FILE and never written here.
KEYSTORE_ACCOUNT=ripe0x
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
ADMIN=0xCB43078C32423F5348Cab5885911C3B5faE217F9
REVENUE_RECIPIENT=0xD4ba7cA95f3983514DDa317C4428CDb8F59c7e72
# OD-236: fixed zero-share final-retirement GRAIL recipient.
RETIREMENT_BENEFICIARY=0xea194A186EBe76A84E2B2027f5f23F81939c05AD
SHAPES=0x6C2F9c00F44FBBF141dD166979903004b80D5f99
FWA_FACTORY=0x81928bA234724A120B3658251D033F4b3EA37bE2
FWA_IMPLEMENTATION=0x20481E3A0A52aFeE811d277b4f49F20d7DA3b293
FWA_VRF_SERVICE=0x38B5dD6b756fC5bC115F0aBEaad0c35C9E2FbB8A
# Default opening seconds after custody creates its FWA pool; purchases also require a playable board and FWA cooldown.
OPEN_DELAY_SECONDS=3600
# Operator share of the full ticket, routed to REVENUE_RECIPIENT.
OPERATOR_BPS=100
CREATE_POOL=0
POOL_SALT=1
# Ordinary creation reads the live factory fee in script/create-fwa-pool.sh.
EXPECTED_CREATION_FEE=
KEEPER_BUDGET_GAS_PRICE_WEI=1000000000
WITHDRAWAL_MAX_WAIT_SECONDS=900
# Batch defaults are 5; Lens availability still limits each quote to current inventory and FWA
# capacity. Custody supports up to 16 concurrent requests, with batch no larger than concurrency.
MAX_CONCURRENT_REQUESTS=5
MAX_BATCH=5
CONCURRENCY_RESERVE=10
# Review window before a proposed FWA pool migration can execute. Zero at deployment on every
# chain (DEC-79); raiseMigrationDelaySeconds only ever raises it after.
MIGRATION_DELAY_SECONDS=0

# Launch economics settings (DEC-178 to DEC-185; docs/HANDOFF-2026-09-29.md section 3). Ladder
# units on every chain: 1 unit is 0.01 ETH on mainnet and 0.0001 ETH on Sepolia (DEC-71), so the
# unit values below are identical across env files. The curve, maintenance and GRAIL_FEED_BPS
# keys are consumed by Deploy.s.sol and Seed.s.sol (TASK-V131), and so are the gate, launch cap
# and minimum NAV keys (TASK-V132). The GRAIL track keys are consumed by Deploy.s.sol and Seed.s.sol
# (TASK-V133).
# Premium curve: rate in bps at turnover knees expressed in bps of NAV per day (0.10 = 1000).
PREMIUM_FLOOR_BPS=200
PREMIUM_MID_BPS=200
PREMIUM_TOP_BPS=200
TURNOVER_KNEE_LOW_BPS=1000
TURNOVER_KNEE_MID_BPS=2500
TURNOVER_KNEE_HIGH_BPS=5000
# Turnover window: trailing seconds, extended to cover at least this many settled pulls, capped.
TURNOVER_WINDOW_SECONDS=172800
TURNOVER_MIN_PULLS=300
TURNOVER_MAX_DAYS=30
# Cheaper Draw funds maintenance from settled pulls; 100 ladder units is 1 ETH mainnet.
MAINTENANCE_BPS=100
MAINTENANCE_FLOOR_UNITS=100
# No opening cap. Sepolia uses an accelerated one-hour funding window for
# rehearsal; mainnet uses 24 hours. Later ETH is price-only at restocking.
GATE_DAYS=4
LAUNCH_CAP_QUEUE_UNITS=10000
LAUNCH_OPENING_CAP_UNITS=0
LAUNCH_CAP_DAYS=7
# Deprecated minimum-NAV withdrawal field; it must remain zero.
MIN_NAV_UNITS=0
# Merge-mode entry-curve reference (5500 = 0.55 ETH testnet, 55 ETH mainnet),
# not a minimum raise or total admission cap. Zero closes later merge-mode
# admission; the admin can change this reference live through setParams.
ADMISSION_FLOOR_UNITS=5500
# Gross ETH admitted per UTC day for gated deposits, in ladder units. Zero leaves the daily limit
# off. Changeable live through setParams.
ADMISSION_DAY_CAP_UNITS=0
# GRAIL merge configuration. Legacy track fields remain in the deployment record for compatibility.
GRAIL_FEED_BPS=400
GRAIL_MINOR_SHARE_BPS=0
GRAIL_MERGE_MODE=true
# Controller reserve: share of each ticket credited to the controller reserve bucket.
RESERVE_BPS=0
GRAIL_MINOR_RUNG_INDEX=4
GRAIL_MINOR_SEED_NOTIONAL_BPS=5000
GRAIL_MINOR_INTERVAL_MIN_PULLS=100
GRAIL_MINOR_INTERVAL_MAX_PULLS=100000
GRAIL_RESEED_CAP_BPS=2500
GRAIL_MAJOR_TARGET_RUNG_INDEX=4
GRAIL_MAJOR_STEP_UP_DAYS=7
GRAIL_MAJOR_STEP_DOWN_DAYS=60
GRAIL_MAJOR_NAV_MULTIPLE=4
GRAIL_MAJOR_DEMAND_DAYS=4
GRAIL_DECAY_WEI_PER_PULL=1000000000000
GRAIL_FLOOR_UNITS=100
# Post-launch (TASK-V136): credit over backing for a Shape used to fund a pull.
PULL_WITH_SHAPES_BONUS_BPS=200
