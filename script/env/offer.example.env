# Standing offer (docs/SPONSOR.md). Values only, no secrets. Copy to script/env/offer.env,
# fill the empty values, then export them with `set -a; source script/env/offer.env; set +a`.
# The broadcaster (keystore account) must be OFFER_OWNER.
OFFER_POOL=
OFFER_OWNER=
# Wrapped Cryptopunks, chain 1.
OFFER_COLLECTION=0xb7F7F6C52F2e2fdb1963Eab30438024864c313F6
# Wei. Registered price 32 ETH, decays to a 0.25 ETH floor by 0.001 ETH per settled pull once Hot.
OFFER_PARKED_PRICE_WEI=32000000000000000000
OFFER_FLOOR_WEI=250000000000000000
OFFER_DECAY_WEI_PER_PULL=1000000000000000
# Seconds from take until the sponsor may reclaim (30 days).
OFFER_RECLAIM_DELAY=2592000
# Wei. Sponsor payment cap from mint fees per deal, 48 ETH.
OFFER_CAP_WEI=48000000000000000000
# Deals of the collection that may be unpaid at once, 1 to 8.
OFFER_MAX_OPEN=2
# Optional. Path of the record the web app reads. Empty writes deployments/<chainId>-offer.json.
OFFER_RECORD=
