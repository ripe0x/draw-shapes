# Local anvil fork of mainnet. Values only. Callers pass RPC_URL (for example
# RPC_URL=http://127.0.0.1:8545). The deploy creates Draw Packs, and the wrapper creates the FWA
# pool after the broadcast when CREATE_POOL=1.
CHAIN_ID=31337
RPC_URL_DEFAULT=
LADDER=mainnet
VERIFY=0
REQUIRE_MAIN_BRANCH=0
WALLET_MODE=anvil
# Anvil account 0.
DEPLOYER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ADMIN=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SHAPES=0x6fE9193276bF7aBCbEE44AB7aFd717d637D6FAf0
FWA_FACTORY=0xF5A3A153164791AB579C3d9ba5DBECf7cDfd300c
FWA_IMPLEMENTATION=0xeaa4d032908a9734a2c7939c0d211c35ad51eb31
FWA_VRF_SERVICE=0xa4adfc35db18326efb3b5d9bf66a8103ec2d5ee2
DRAW_PACKS=
# The wrapper impersonates the factory owner to set the creation fee to EXPECTED_CREATION_FEE
# and lift the beta gate before createFwaPool.
CREATE_POOL=1
EXPECTED_CREATION_FEE=0

# Mix table: rows separated by ';', each row is rung,rung,...:shareBps. Rungs index the Shapes ladder;
# rows of two or more rungs are Draw Packs. Shares sum to 10000.
MIX_ROWS="0:3800;0,0:2800;0,0,0:1900;1:1000;2:400;3:100"

# Fee split in bps. premium + maintenance + feed is at most 1000.
PREMIUM_BPS=200
MAINTENANCE_BPS=100
FEED_BPS=400

# Entry fee in bps: the share of a deposit routed to the GRAIL buckets. It is ENTRY_PAYBACK_DAYS
# days of depositor yield, clamped to [ENTRY_FLOOR_BPS, ENTRY_CAP_BPS]. The cap is at most 10000.
ENTRY_FLOOR_BPS=1000
ENTRY_CAP_BPS=2500
ENTRY_PAYBACK_DAYS=20

# GRAIL, wei. One fund and one ladder. The target is 5, 10, 25, 50 or 100 ETH (the next cycle reads it
# from setGrailTarget). LIST_BPS is the list price of a merged item as a share of its backing. A list
# price decays by DECAY_WEI_PER_PULL per pull down to PIECE_FLOOR_WEI for a 1 ETH piece and to FLOOR_WEI
# for any other item, and reprices once the decay reaches 1 percent of the list price. Pool requires
# LIST_BPS 1 to 10000, PIECE_FLOOR_WEI nonzero and at most 1 ETH, and FLOOR_WEI nonzero and at most
# 5 ETH * LIST_BPS / 10000.
GRAIL_TARGET_WEI=25000000000000000000
GRAIL_LIST_BPS=7500
GRAIL_DECAY_WEI_PER_PULL=1000000000000000
GRAIL_PIECE_FLOOR_WEI=250000000000000000
GRAIL_FLOOR_WEI=1000000000000000000

# Deposits are admitted while NAV is below max(NAV_CAP_FLOOR_WEI, trailing daily fee volume * 10000 /
# TURNOVER_BPS). 0 floor means no cap.
NAV_CAP_FLOOR_WEI=69000000000000000000
# Target daily fee volume over NAV, in bps, 1 to 10000.
TURNOVER_BPS=1250
# Seconds after open() during which deposits revert. 0 so local runs exercise the deposit page right after open.
FOUNDER_WINDOW_SECONDS=0
# Minimum seconds between inventory changes. At least the FWA factory's inventoryChangeCooldown.
ROTATE_INTERVAL_SECONDS=900
# Seconds from FWA pool creation to the earliest open().
OPENING_DEADLINE_SECONDS=3600
MIN_ITEMS=100
GRAIL_PROB_CAP_BPS=1000
# Replacement listing. settle lists when this many replacements are queued, or the queue has been
# nonempty for BATCH_MAX_AGE_SECONDS.
BATCH_MIN=20
BATCH_MAX_AGE_SECONDS=3600
# Replacement row choice: probability in bps of the surprise step, multiplier of a row's relative
# deficit in its draw weight, and headroom in bps above a row's target.
SURPRISE_BPS=200
RESTORE_K=8
BAND_BPS=3000
# Share of ordinary NAV in bps that cash keeps after a mint or a kept Shape.
RESERVE_BPS=1000
# Wei added to the gas cost in every settle and rotate refund (setTip, at most 0.01 ether).
TIP_WEI=200000000000000
