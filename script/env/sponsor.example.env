# One sponsored prize deal (docs/SPONSOR.md). Values only, no secrets. Copy to script/env/sponsor.env,
# fill the empty values, then export them with `set -a; source script/env/sponsor.env; set +a`.
# The broadcaster (keystore account) must be SPONSOR_OWNER.
SPONSOR_POOL=
SPONSOR_OWNER=
SPONSOR_SPONSOR=
# Wrapped Cryptopunks, chain 1.
SPONSOR_COLLECTION=0xb7F7F6C52F2e2fdb1963Eab30438024864c313F6
# Wei. Registered price 30 ETH, decays to a 0.25 ETH floor by 0.001 ETH per settled pull once Hot.
SPONSOR_PARKED_PRICE_WEI=30000000000000000000
SPONSOR_FLOOR_WEI=250000000000000000
SPONSOR_DECAY_WEI_PER_PULL=1000000000000000
# Seconds from the sponsor's stake(tokenId) until the sponsor may reclaim (30 days).
SPONSOR_RECLAIM_DELAY=2592000
# Wei. Sponsor payment cap from mint fees, 45 ETH.
SPONSOR_CAP_WEI=45000000000000000000
# Optional. An existing FeeSplit owned by SPONSOR_OWNER whose terms are unlocked. Empty deploys a new one.
SPONSOR_FEE_SPLIT=
# Optional. Path of the deal record the web app reads. Empty writes deployments/<chainId>-sponsor.json.
SPONSOR_RECORD=
